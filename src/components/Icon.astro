---
/** Linijske ikone: potez 1.5, pravi krajevi — isti jezik kao pravougaona dugmad. */
interface Props {
  name: 'arrow' | 'arrow-up' | 'phone' | 'pin' | 'menu' | 'close' | 'external';
  class?: string;
}

const { name, class: className } = Astro.props;

const paths: Record<Props['name'], string> = {
  arrow: 'M4 12h15M13 6l6 6-6 6',
  'arrow-up': 'M12 20V5M6 11l6-6 6 6',
  phone:
    'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z',
  pin: 'M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21zM12 12.2a2.7 2.7 0 1 0 0-5.4 2.7 2.7 0 0 0 0 5.4z',
  menu: 'M3 8h18M3 16h18',
  close: 'M5 5l14 14M19 5L5 19',
  external: 'M14 4h6v6M20 4l-9 9M18 14v6H4V6h6',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]}></path>
</svg>

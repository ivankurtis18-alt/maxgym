---
import type { ImageKey } from '../data/images';
import Media from './Media.astro';
import type { ComponentProps } from 'astro/types';

type Art = NonNullable<ComponentProps<typeof Media>['art']>[number];
import Proto from './Proto.astro';

// Svaka pozicija u mreži ima svoj format; redosled prati kompoziciju:
// pokret · prostor · detalj sa čovekom · oprema · oprema · pokret.
// ratio: okvir na desktopu · art: okvir na tabletu/telefonu (vidi CSS)
// speed: pomak pri skrolu (desktop) — slojevi različite dubine
const TABLET = '(max-width: 960px)';
const PHONE = '(max-width: 560px)';
const shots: { image: ImageKey; ratio: number; art: Art[]; sizes: string; speed: number }[] = [
  { image: 'barbellGrip', ratio: 1 / 2, art: [{ media: TABLET, ratio: 3 / 2, sizes: '100vw' }], sizes: '42vw', speed: -0.06 },
  { image: 'darkHall', ratio: 3 / 2, art: [{ media: TABLET, ratio: 4 / 5, sizes: '50vw' }], sizes: '58vw', speed: 0 },
  { image: 'kettlebellWoman', ratio: 4 / 5, art: [], sizes: '(min-width: 961px) 25vw, 50vw', speed: 0.04 },
  { image: 'barRack', ratio: 4 / 5, art: [], sizes: '(min-width: 961px) 30vw, 50vw', speed: -0.1 },
  { image: 'kettlebellRow', ratio: 3 / 2, art: [{ media: TABLET, ratio: 4 / 5, sizes: '50vw' }], sizes: '34vw', speed: 0.05 },
  { image: 'barbellSetup', ratio: 21 / 9, art: [{ media: PHONE, ratio: 3 / 2, sizes: '100vw' }], sizes: '(min-width: 961px) 58vw, 100vw', speed: 0 },
];
---

<section class="gal section" id="galerija" aria-labelledby="gal-title">
  <div class="wrap">
    <header class="gal__head">
      <p class="label eyebrow">Galerija</p>
      <h2 class="display h2" id="gal-title" data-split>Iz <em>sale</em></h2>
      <Proto text="Privremene fotografije" />
    </header>

    <ul class="gal__grid">
      {
        shots.map((shot, i) => (
          <li class={`gal__item gal__item--${i + 1}`} data-speed={shot.speed}>
            <figure class="media" data-img>
              <Media
                image={shot.image}
                ratio={shot.ratio}
                art={shot.art}
                widths={[480, 800, 1200, 1600]}
                sizes={shot.sizes}
              />
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .gal__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--s-6);
    margin-bottom: var(--head-gap);
  }

  .gal__head .eyebrow {
    flex-basis: 100%;
  }

  .gal__head :global(.proto) {
    margin-bottom: 0.6em;
  }

  .gal__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
  }

  .gal__item figure {
    height: 100%;
  }

  /* Hover: fotografija se lagano primakne i posvetli.
     `scale` je odvojen od transform-a koji koristi paralaksa. */
  .gal__item :global(img) {
    transition:
      scale 0.9s var(--ease),
      filter var(--dur) var(--ease);
  }

  @media (hover: hover) {
    .gal__item:hover :global(img) {
      scale: 1.04;
      filter: grayscale(1) contrast(1.14) brightness(calc(0.98 * var(--tone, 1)));
    }
  }

  /* Kompozicija: visoka slika levo, stepenasta desna strana,
     široka traka na dnu koja se ne poklapa sa gornjom ivicom. */
  .gal__item--1 {
    grid-column: 1 / 6;
    grid-row: 1 / 3;
  }

  .gal__item--2 {
    grid-column: 6 / -1;
    aspect-ratio: var(--r-land);
  }

  .gal__item--3 {
    grid-column: 6 / 9;
    aspect-ratio: var(--r-portrait);
  }

  .gal__item--4 {
    grid-column: 9 / -1;
    aspect-ratio: var(--r-portrait);
    margin-top: clamp(2rem, 6vw, 5rem);
  }

  .gal__item--5 {
    grid-column: 1 / 5;
    aspect-ratio: var(--r-land);
    align-self: start;
  }

  .gal__item--6 {
    grid-column: 5 / -1;
    aspect-ratio: var(--r-wide);
  }

  /* Tablet i mobilni: ritam puna · par · par · puna */
  @media (max-width: 960px) {
    .gal__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gal__item--1,
    .gal__item--6 {
      grid-column: 1 / -1;
      grid-row: auto;
      aspect-ratio: var(--r-land);
    }

    .gal__item--2,
    .gal__item--3,
    .gal__item--4,
    .gal__item--5 {
      grid-column: auto;
      aspect-ratio: var(--r-portrait);
      margin-top: 0;
    }
  }

  @media (min-width: 561px) and (max-width: 960px) {
    .gal__item--6 {
      aspect-ratio: var(--r-wide);
    }
  }
</style>

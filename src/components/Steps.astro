---
/**
 * Koraci na šipci — zajednička komponenta (Prvi dolazak, Proces
 * personalnog treninga). Pravi redosled, pa su brojevi opravdani.
 * Ploče se „natovare" kada ih dosegne ljubičasto punjenje šipke
 * (motion.ts, gest OPTEREĆENJE).
 */
interface Props {
  steps: { title: string; text: string }[];
}

const { steps } = Astro.props;
---

<ol class="steps" data-steps>
  {
    steps.map((step, i) => (
      <li class="step" data-reveal>
        <span class="step__num" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class="h3 step__title">
          <span class="sr-only">Korak {i + 1}: </span>
          {step.title}
        </h3>
        <p class="muted step__text">{step.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    --plate-w: 12px;
    --plate-h: 44px;
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
    padding-top: calc(var(--plate-h) + var(--s-6));
  }

  /* šipka */
  .steps::before {
    content: '';
    position: absolute;
    top: calc(var(--plate-h) / 2);
    left: 0;
    right: calc(-1 * var(--gutter));
    height: 2px;
    background: var(--line-strong);
  }

  /* punjenje šipke (--fill 0 → 1, vodi motion.ts); bez JS-a ne postoji */
  .steps::after {
    content: '';
    position: absolute;
    top: calc(var(--plate-h) / 2);
    left: 0;
    right: calc(-1 * var(--gutter));
    height: 2px;
    background: var(--volt);
    transform: scaleX(var(--fill, 0));
    transform-origin: left;
  }

  .step {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--s-4);
    padding-right: var(--s-5);
  }

  /* ploča */
  .step::before {
    content: '';
    position: absolute;
    top: calc(-1 * (var(--plate-h) + var(--s-6)));
    left: 0;
    width: var(--plate-w);
    height: var(--plate-h);
    background: var(--volt);
    z-index: 1;
    transform-origin: 50% 50%;
    transition:
      transform var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  /* Pre nego što ga šipka dosegne, korak je „prazan": niska siva
     ploča i utišan broj. Stanje uključuje motion.ts (.is-live). */
  .steps.is-live .step:not(.is-loaded)::before {
    transform: scaleY(0.3);
    background: var(--line-strong);
  }

  .steps.is-live .step:not(.is-loaded) .step__num {
    -webkit-text-stroke-color: var(--line-strong);
  }

  .step__num {
    font-family: var(--font-display);
    font-stretch: var(--w-tight);
    font-weight: 800;
    font-size: clamp(3.5rem, 2.5rem + 3vw, 6rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--chalk-2);
    transition: -webkit-text-stroke-color var(--dur-slow) var(--ease);
  }

  .step__text {
    max-width: 30ch;
  }

  @media (max-width: 960px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: calc(var(--plate-h) + var(--s-6) * 2);
    }
  }

  /* Tablet: dva reda, pa svaki korak nosi svoj deo šipke */
  @media (min-width: 561px) and (max-width: 960px) {
    .steps::before,
    .steps::after {
      display: none;
    }

    .step::after {
      content: '';
      position: absolute;
      top: calc(-1 * (var(--plate-h) / 2 + var(--s-6)) - 1px);
      left: 0;
      right: calc(-1 * var(--gap));
      height: 2px;
      background: var(--line-strong);
    }
  }

  /* Mobilni: šipka postaje vertikalna, ploče su vodoravne */
  @media (max-width: 560px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 0;
      padding-left: calc(var(--plate-h) / 2 + var(--s-6));
      row-gap: var(--s-7);
    }

    .steps::before,
    .steps::after {
      top: 0;
      bottom: 0;
      left: calc(var(--plate-h) / 2 - 1px);
      right: auto;
      width: 2px;
      height: auto;
    }

    .steps::after {
      transform: scaleY(var(--fill, 0));
      transform-origin: top;
    }

    .step::before {
      top: 0.35rem;
      left: calc(-1 * (var(--plate-h) / 2 + var(--s-6)));
      width: var(--plate-h);
      height: var(--plate-w);
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Sala from '../components/Sala.astro';
import Trening from '../components/Trening.astro';
import Zasto from '../components/Zasto.astro';
import PrviDolazak from '../components/PrviDolazak.astro';
import Clanarina from '../components/Clanarina.astro';
import Galerija from '../components/Galerija.astro';
import Kontakt from '../components/Kontakt.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header />
  <main id="main">
    <Hero />
    <Sala />
    <Trening />
    <Zasto />
    <PrviDolazak />
    <Clanarina />
    <Galerija />
    <Kontakt />
  </main>
  <Footer />
</Base>
